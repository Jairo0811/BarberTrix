{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": { "developmentClient": true, "distribution": "internal", "environment": "development", "env": { "EXPO_PUBLIC_APP_ENV": "Development" } },
    "preview": { "distribution": "internal", "environment": "preview", "env": { "EXPO_PUBLIC_APP_ENV": "Preview" }, "android": { "buildType": "apk" } },
    "production": { "autoIncrement": true, "environment": "production", "env": { "EXPO_PUBLIC_APP_ENV": "Production" } }
  },
  "submit": { "production": {} }
}
