{
  "expo": {
    "name": "BarberTurn",
    "slug": "barberturn",
    "scheme": "barberturn",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": true },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jmsoftwaresolutions.barberturn"
    },
    "android": {
      "package": "com.jmsoftwaresolutions.barberturn"
    }
  }
}
