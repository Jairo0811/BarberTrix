BARBERTRIX_DB_PASSWORD=ChangeMe_OnlyForLocalDevelopment_123!
BARBERTRIX_DB_PORT=14330
BARBERTRIX_JWT_KEY=replace-with-a-random-secret-of-at-least-32-characters
BARBERTRIX_DEMO_PASSWORD=replace-with-local-demo-password
BARBERTRIX_FRONTEND_URL=http://localhost:8081
# Origin used by backend-generated links and PayPal return/cancel validation.
# Keep 5173 when running Vite locally; set 8081 when testing the containerized web app.
BARBERTRIX_FRONTEND_ORIGIN=http://localhost:5173

# Google / Apple sign-in. External providers require a public HTTPS API URL
# because their OAuth callbacks cannot target a private LAN address.
BARBERTRIX_EXTERNAL_AUTH_PUBLIC_BASE_URL=
# Must exactly match the browser callback, for example:
# http://localhost:5173/#/auth-callback
BARBERTRIX_EXTERNAL_AUTH_WEB_RETURN_URI=
BARBERTRIX_GOOGLE_CLIENT_ID=
BARBERTRIX_GOOGLE_CLIENT_SECRET=
BARBERTRIX_APPLE_CLIENT_ID=
BARBERTRIX_APPLE_TEAM_ID=
BARBERTRIX_APPLE_KEY_ID=
BARBERTRIX_APPLE_PRIVATE_KEY=

# PayPal Sandbox. Never commit real Client Secrets.
# Create/reuse the product and plan IDs with:
# ./scripts/paypal/Initialize-BarberTrixPayPalSandbox.ps1
BARBERTRIX_PAYPAL_CLIENT_ID=
BARBERTRIX_PAYPAL_SECRET=
BARBERTRIX_PAYPAL_WEBHOOK_ID=
BARBERTRIX_PAYPAL_PRO_PLAN_ID=
BARBERTRIX_PAYPAL_BUSINESS_PLAN_ID=
