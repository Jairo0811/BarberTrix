BARBERTRIX_DB_PASSWORD=replace-with-a-strong-sa-bootstrap-password
BARBERTRIX_DB_APP_PASSWORD=replace-with-a-strong-app-password
BARBERTRIX_DB_MIGRATOR_PASSWORD=replace-with-a-strong-migrator-password
BARBERTRIX_JWT_KEY=replace-with-at-least-64-random-characters
BARBERTRIX_PUBLIC_ORIGIN=https://app.example.com
# ASP.NET Core AllowedHosts: hostnames only, separated with semicolons when multiple hosts are needed.
BARBERTRIX_ALLOWED_HOSTS=app.example.com
BARBERTRIX_SMTP_HOST=smtp.example.com
BARBERTRIX_SMTP_PORT=587
BARBERTRIX_SMTP_USERNAME=replace-me
BARBERTRIX_SMTP_PASSWORD=replace-me
BARBERTRIX_EMAIL_FROM=no-reply@example.com
BARBERTRIX_TURNSTILE_SECRET=replace-me
BARBERTRIX_PAYPAL_CLIENT_ID=replace-me
BARBERTRIX_PAYPAL_SECRET=replace-me
BARBERTRIX_PAYPAL_WEBHOOK_ID=replace-me
BARBERTRIX_PAYPAL_PRO_PLAN_ID=replace-me
BARBERTRIX_PAYPAL_BUSINESS_PLAN_ID=replace-me
# Opcional: requerido solo si está habilitada la seguridad reforzada de Expo Push.
BARBERTRIX_EXPO_ACCESS_TOKEN=
