{
  "name": "barbertrix-mobile",
  "version": "0.3.0",
  "private": true,
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "generate:route-types": "expo customize tsconfig.json",
    "typecheck": "npm run generate:route-types && tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "i18n:check": "node scripts/audit-i18n.cjs",
    "i18n:report": "node scripts/audit-i18n.cjs --report"
  },
  "dependencies": {
    "@microsoft/signalr": "^9.0.6",
    "@tanstack/react-query": "^5.87.1",
    "expo": "~57.0.21",
    "expo-constants": "~57.0.15",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.9",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "typescript": "~6.0.3"
  }
}
