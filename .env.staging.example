# Example ONLY; never use placeholder values for a running environment.
# Copy to .env.staging (ignored by Git) and store real secrets in a secret manager.
# Staging must have its own isolated SQL volumes, credentials and sandbox accounts.
BARBERTRIX_DB_PASSWORD=replace-with-strong-staging-bootstrap-password
BARBERTRIX_DB_APP_PASSWORD=replace-with-strong-staging-app-password
BARBERTRIX_DB_MIGRATOR_PASSWORD=replace-with-strong-staging-migrator-password
BARBERTRIX_JWT_KEY=replace-with-at-least-64-random-staging-characters
BARBERTRIX_PUBLIC_ORIGIN=https://staging.example.com
BARBERTRIX_ALLOWED_HOSTS=staging.example.com
BARBERTRIX_SMTP_HOST=replace-with-staging-smtp-host
BARBERTRIX_SMTP_PORT=587
BARBERTRIX_SMTP_USERNAME=replace-with-staging-smtp-user
BARBERTRIX_SMTP_PASSWORD=replace-with-staging-smtp-secret
BARBERTRIX_EMAIL_FROM=staging@example.com
BARBERTRIX_TURNSTILE_SITE_KEY=replace-with-staging-turnstile-site-key
BARBERTRIX_TURNSTILE_SECRET=replace-with-staging-turnstile-secret
# Sandbox credentials ONLY. The overlay forces PayPal__Sandbox=true.
BARBERTRIX_PAYPAL_CLIENT_ID=replace-with-sandbox-client-id
BARBERTRIX_PAYPAL_SECRET=replace-with-sandbox-client-secret
BARBERTRIX_PAYPAL_WEBHOOK_ID=replace-with-sandbox-webhook-id
BARBERTRIX_PAYPAL_PRO_PLAN_ID=replace-with-sandbox-pro-plan-id
BARBERTRIX_PAYPAL_BUSINESS_PLAN_ID=replace-with-sandbox-business-plan-id
BARBERTRIX_EXPO_ACCESS_TOKEN=
