{
  "expo": {
    "name": "BarberTrix",
    "slug": "barbertrix",
    "scheme": "barbertrix",
    "version": "0.3.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "BarberTrix necesita acceso a tus fotos para seleccionar el logo y la portada de tu barbería.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BarberTrix usa tu ubicación solo cuando eliges ubicar tu barbería en el mapa."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jmsoftwaresolutions.barbertrix"
    },
    "android": {
      "package": "com.jmsoftwaresolutions.barbertrix"
    }
  }
}
